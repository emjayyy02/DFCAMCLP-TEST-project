{
  "name": "dfcamclp-portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude **/*.integration.test.ts",
    "test:db": "vitest run src/tests/database.integration.test.ts --no-file-parallelism",
    "test:auth": "vitest run src/tests/authentication.integration.test.ts --no-file-parallelism",
    "test:access": "vitest run src/tests/access-control.integration.test.ts --no-file-parallelism",
    "env:check": "tsx scripts/check-env.ts",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset:dev": "tsx scripts/db/reset-dev.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@next/env": "16.3.5",
    "@radix-ui/react-slot": "1.3.3",
    "better-auth": "1.7.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
